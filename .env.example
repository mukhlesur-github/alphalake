# Copy to .env and fill in. Never commit .env.
AWS_PROFILE=alphalake
AWS_REGION=us-west-2
# Filled automatically by `make tf-output` (bucket name contains your AWS account id)
ALPHALAKE_BUCKET=

# Snowflake account identifier: <orgname>-<accountname>  (Snowsight -> Admin -> Accounts)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_DATABASE=ALPHALAKE

# Pipeline service user (migrations, loaders, dbt)
SNOWFLAKE_PIPELINE_USER=SVC_ALPHALAKE_PIPELINE
SNOWFLAKE_PIPELINE_KEY=keys/svc_alphalake_pipeline.p8
SNOWFLAKE_PIPELINE_ROLE=ALPHALAKE_ENGINEER
SNOWFLAKE_PIPELINE_WAREHOUSE=ALPHALAKE_WH_PIPELINE

# App service user (Streamlit + agent). It switches to the end user's persona role per request.
SNOWFLAKE_APP_USER=SVC_ALPHALAKE_APP
SNOWFLAKE_APP_KEY=keys/svc_alphalake_app.p8
SNOWFLAKE_APP_WAREHOUSE=ALPHALAKE_WH_APP

# Cortex COMPLETE model (any model available in your region / via cross-region inference)
CORTEX_LLM_MODEL=openai-gpt-4.1

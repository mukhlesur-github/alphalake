-- AlphaLake Snowflake foundation (replaces snowflake.tf). Run as ACCOUNTADMIN; idempotent.
-- Rendered by `make snowflake-sql` (public keys + AWS account id inlined) -> infra/snowflake/setup.sql
USE ROLE ACCOUNTADMIN;

-- Cortex: allow models that aren't hosted in this region (e.g. openai-gpt-4.1).
ALTER ACCOUNT SET CORTEX_ENABLED_CROSS_REGION = 'ANY_REGION';

-- --- Containers --------------------------------------------------------------------
CREATE DATABASE IF NOT EXISTS ALPHALAKE DATA_RETENTION_TIME_IN_DAYS = 1;
CREATE SCHEMA IF NOT EXISTS ALPHALAKE.BRONZE;
CREATE SCHEMA IF NOT EXISTS ALPHALAKE.SILVER;
CREATE SCHEMA IF NOT EXISTS ALPHALAKE.GOLD;
CREATE SCHEMA IF NOT EXISTS ALPHALAKE.SEMANTIC;
CREATE SCHEMA IF NOT EXISTS ALPHALAKE.DOCS;
CREATE SCHEMA IF NOT EXISTS ALPHALAKE.AUDIT;

-- --- Compute + cost guardrail ------------------------------------------------------
CREATE RESOURCE MONITOR IF NOT EXISTS ALPHALAKE_RM WITH
  CREDIT_QUOTA = 40 FREQUENCY = MONTHLY START_TIMESTAMP = IMMEDIATELY
  TRIGGERS ON 50 PERCENT DO NOTIFY ON 80 PERCENT DO NOTIFY
           ON 95 PERCENT DO SUSPEND ON 100 PERCENT DO SUSPEND_IMMEDIATE;

CREATE WAREHOUSE IF NOT EXISTS ALPHALAKE_WH_PIPELINE
  WAREHOUSE_SIZE = XSMALL AUTO_SUSPEND = 60 AUTO_RESUME = TRUE INITIALLY_SUSPENDED = TRUE;
CREATE WAREHOUSE IF NOT EXISTS ALPHALAKE_WH_APP
  WAREHOUSE_SIZE = XSMALL AUTO_SUSPEND = 60 AUTO_RESUME = TRUE INITIALLY_SUSPENDED = TRUE;
ALTER WAREHOUSE ALPHALAKE_WH_PIPELINE SET RESOURCE_MONITOR = ALPHALAKE_RM;
ALTER WAREHOUSE ALPHALAKE_WH_APP SET RESOURCE_MONITOR = ALPHALAKE_RM;

-- --- Roles -------------------------------------------------------------------------
CREATE ROLE IF NOT EXISTS ALPHALAKE_ENGINEER
  COMMENT = 'Builds and runs pipelines, migrations and dbt. Owns all objects inside the schemas.';
CREATE ROLE IF NOT EXISTS ALPHALAKE_PM;
CREATE ROLE IF NOT EXISTS ALPHALAKE_ANALYST;
GRANT ROLE ALPHALAKE_ENGINEER TO ROLE SYSADMIN;
GRANT ROLE ALPHALAKE_PM       TO ROLE SYSADMIN;
GRANT ROLE ALPHALAKE_ANALYST  TO ROLE SYSADMIN;

-- Engineer: full control inside the database.
GRANT USAGE, CREATE SCHEMA, MONITOR ON DATABASE ALPHALAKE TO ROLE ALPHALAKE_ENGINEER;
GRANT ALL PRIVILEGES ON SCHEMA ALPHALAKE.BRONZE   TO ROLE ALPHALAKE_ENGINEER;
GRANT ALL PRIVILEGES ON SCHEMA ALPHALAKE.SILVER   TO ROLE ALPHALAKE_ENGINEER;
GRANT ALL PRIVILEGES ON SCHEMA ALPHALAKE.GOLD     TO ROLE ALPHALAKE_ENGINEER;
GRANT ALL PRIVILEGES ON SCHEMA ALPHALAKE.SEMANTIC TO ROLE ALPHALAKE_ENGINEER;
GRANT ALL PRIVILEGES ON SCHEMA ALPHALAKE.DOCS     TO ROLE ALPHALAKE_ENGINEER;
GRANT ALL PRIVILEGES ON SCHEMA ALPHALAKE.AUDIT    TO ROLE ALPHALAKE_ENGINEER;
GRANT USAGE, OPERATE, MONITOR ON WAREHOUSE ALPHALAKE_WH_PIPELINE TO ROLE ALPHALAKE_ENGINEER;
GRANT USAGE, OPERATE, MONITOR ON WAREHOUSE ALPHALAKE_WH_APP      TO ROLE ALPHALAKE_ENGINEER;
-- Tasks run as their owner; the owner needs EXECUTE TASK at account level.
GRANT EXECUTE TASK ON ACCOUNT TO ROLE ALPHALAKE_ENGINEER;
-- Cortex embed/complete/search for pipelines and personas.
GRANT DATABASE ROLE SNOWFLAKE.CORTEX_USER TO ROLE ALPHALAKE_ENGINEER;
GRANT DATABASE ROLE SNOWFLAKE.CORTEX_USER TO ROLE ALPHALAKE_PM;
GRANT DATABASE ROLE SNOWFLAKE.CORTEX_USER TO ROLE ALPHALAKE_ANALYST;

-- Personas: read GOLD / SEMANTIC, use DOCS + AUDIT schemas (search services / audit table granted in V004/V005).
{% for p in ['ALPHALAKE_PM', 'ALPHALAKE_ANALYST'] %}
GRANT USAGE ON DATABASE ALPHALAKE TO ROLE {{p}};
GRANT USAGE ON SCHEMA ALPHALAKE.GOLD TO ROLE {{p}};
GRANT USAGE ON SCHEMA ALPHALAKE.SEMANTIC TO ROLE {{p}};
GRANT USAGE ON SCHEMA ALPHALAKE.DOCS TO ROLE {{p}};
GRANT USAGE ON SCHEMA ALPHALAKE.AUDIT TO ROLE {{p}};
GRANT SELECT ON FUTURE TABLES IN SCHEMA ALPHALAKE.GOLD TO ROLE {{p}};
GRANT SELECT ON FUTURE VIEWS  IN SCHEMA ALPHALAKE.GOLD TO ROLE {{p}};
GRANT SELECT ON FUTURE TABLES IN SCHEMA ALPHALAKE.SEMANTIC TO ROLE {{p}};
GRANT SELECT ON FUTURE VIEWS  IN SCHEMA ALPHALAKE.SEMANTIC TO ROLE {{p}};
GRANT USAGE ON WAREHOUSE ALPHALAKE_WH_APP TO ROLE {{p}};
{% endfor %}

-- --- Service users (key-pair only, no passwords) -----------------------------------
CREATE USER IF NOT EXISTS SVC_ALPHALAKE_PIPELINE TYPE = SERVICE
  DEFAULT_ROLE = ALPHALAKE_ENGINEER DEFAULT_WAREHOUSE = ALPHALAKE_WH_PIPELINE DEFAULT_SECONDARY_ROLES = ();
ALTER USER SVC_ALPHALAKE_PIPELINE SET RSA_PUBLIC_KEY = '{{pipeline_pubkey}}';
CREATE USER IF NOT EXISTS SVC_ALPHALAKE_APP TYPE = SERVICE
  DEFAULT_ROLE = ALPHALAKE_ANALYST DEFAULT_WAREHOUSE = ALPHALAKE_WH_APP
  DEFAULT_SECONDARY_ROLES = ();  -- role inheritance relies on exactly one active role
ALTER USER SVC_ALPHALAKE_APP SET RSA_PUBLIC_KEY = '{{app_pubkey}}';
GRANT ROLE ALPHALAKE_ENGINEER TO USER SVC_ALPHALAKE_PIPELINE;
GRANT ROLE ALPHALAKE_PM       TO USER SVC_ALPHALAKE_APP;
GRANT ROLE ALPHALAKE_ANALYST  TO USER SVC_ALPHALAKE_APP;

-- --- Storage integration (Snowflake side of the S3 trust) --------------------------
-- We choose the external ID, so this can exist before the IAM role; Terraform's role trusts
-- STORAGE_AWS_IAM_USER_ARN (DESC INTEGRATION) + this ID.
CREATE STORAGE INTEGRATION IF NOT EXISTS ALPHALAKE_S3_INT
  TYPE = EXTERNAL_STAGE STORAGE_PROVIDER = 'S3' ENABLED = TRUE
  STORAGE_AWS_ROLE_ARN = 'arn:aws:iam::{{aws_account_id}}:role/alphalake-snowflake-s3-read'
  STORAGE_AWS_EXTERNAL_ID = 'alphalake_{{aws_account_id}}'
  STORAGE_ALLOWED_LOCATIONS = ('s3://alphalake-landing-{{aws_account_id}}/landing/');
-- Re-assert in case the integration pre-existed with other settings (IF NOT EXISTS would keep them).
ALTER STORAGE INTEGRATION ALPHALAKE_S3_INT SET
  STORAGE_AWS_ROLE_ARN = 'arn:aws:iam::{{aws_account_id}}:role/alphalake-snowflake-s3-read'
  STORAGE_AWS_EXTERNAL_ID = 'alphalake_{{aws_account_id}}'
  STORAGE_ALLOWED_LOCATIONS = ('s3://alphalake-landing-{{aws_account_id}}/landing/');
GRANT USAGE ON INTEGRATION ALPHALAKE_S3_INT TO ROLE ALPHALAKE_ENGINEER;
